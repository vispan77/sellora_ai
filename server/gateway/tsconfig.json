//modifield configuration for our project
{
  "compilerOptions": {
    "target": "ES2022",                 // JavaScript target version
    "module": "NodeNext",               // Node.js module system
    "moduleResolution": "NodeNext",     // Module resolution strategy

    "rootDir": "./src",                 // TypeScript source folder
    "outDir": "./dist",                 // Compiled JavaScript folder

    "types": ["node"],                  // Node.js type definitions

    "strict": true,                     // Enable strict type checking
    "esModuleInterop": true,            // Improve module compatibility

    "skipLibCheck": true,               // Skip library declaration checking
    "forceConsistentCasingInFileNames": true // Keep file-name casing consistent
  },

  "include": [
    "src/**/*.ts",                      // Include TypeScript files
    "src/**/*.d.ts"                     // Include declaration files
  ],

  "exclude": [
    "node_modules",                     // Ignore dependencies
    "dist"                              // Ignore compiled files
  ]
}
